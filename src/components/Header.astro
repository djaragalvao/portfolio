---
import { url, isCurrent } from '../lib/url';

const { pathname } = Astro.url;
---

<header class="cabecalho">
  <div class="container cabecalho-conteudo">
    <a class="logo" href={url()} aria-label="Djara, página inicial">V.</a>

    <nav aria-label="Menu principal">
      <ul class="menu-lista">
        <li><a class="menu-link" href={url()} aria-current={isCurrent(pathname, '') ? 'page' : undefined}>Início</a></li>
        <li><a class="menu-link" href={url('sobre/')} aria-current={isCurrent(pathname, 'sobre/') ? 'page' : undefined}>Sobre</a></li>
        <li><a class="menu-link" href={url('curriculo.pdf')} target="_blank" rel="noopener">Currículo<span class="visualmente-oculto"> (abre em nova aba)</span></a></li>
        <li><a class="menu-link" href="https://www.linkedin.com/in/seu-perfil" target="_blank" rel="noopener">LinkedIn<span class="visualmente-oculto"> (abre em nova aba)</span></a></li>
      </ul>
    </nav>
  </div>
</header>
