---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseCard from '../components/CaseCard.astro';
---

<BaseLayout title="Djara | Designer de UI/UX" description="Portfólio de Djara, designer de UI/UX.">

  <!-- ================= HERO ================= -->
  <section class="hero" aria-labelledby="titulo-principal">
    <div class="container">
      <h1 class="hero-titulo" id="titulo-principal">Olá, me chamo Djara</h1>
      <p class="hero-subtitulo">Designer de UI/UX com foco em interfaces simples e acessíveis. Atualmente, desenho produtos digitais e conduzo pesquisas com usuários no <strong>Instituto Atlântico</strong>.</p>
    </div>
  </section>

  <!-- ================= CASES ================= -->
  <section class="cases" aria-labelledby="titulo-cases">
    <div class="container">
      <h2 class="visualmente-oculto" id="titulo-cases">Projetos</h2>

      <div class="cases-grade">

        <!-- CASE 1: copie um <CaseCard /> para adicionar mais (imagens ficam em public/img) -->
        <CaseCard
          href="case-1/"
          img="img/case-1-capa.jpg"
          alt="Telas do app de agendamento de consultas em um notebook e em um celular"
          title="App de Agendamento"
          description="Redesign de um app de agendamento de consultas, focado em reduzir as etapas até a confirmação e diminuir as faltas dos pacientes."
        />

        <!-- CASE 2 -->
        <CaseCard
          href="case-2/"
          img="img/case-2-capa.jpg"
          alt="Painel financeiro com gráficos de fluxo de caixa exibido em um notebook"
          title="Painel Financeiro"
          description="Um painel para pequenas empresas, focado em tornar a leitura do fluxo de caixa clara para quem não é da área financeira."
        />

      </div>
    </div>
  </section>

</BaseLayout>
