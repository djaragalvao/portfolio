---
// Ilustração genérica de dashboard (sem telas reais, projeto sob NDA).
// As cores vêm das variáveis do tema, então funciona no claro e no escuro.
const barras = [
  { x: 126, y: 150, h: 40 },
  { x: 164, y: 120, h: 70 },
  { x: 202, y: 135, h: 55 },
  { x: 240, y: 105, h: 85 },
  { x: 278, y: 128, h: 62 },
  { x: 316, y: 95, h: 95, destaque: true },
  { x: 354, y: 116, h: 74 },
];
const kpis = [108, 210, 312];
---

<svg class="ilustracao-dashboard" viewBox="0 0 420 300" aria-hidden="true" focusable="false">
  <rect class="il-painel" width="420" height="300" rx="10" />
  <rect class="il-lateral" width="90" height="300" rx="10" />
  {[24, 52, 80, 108, 136].map((y, i) => (
    <rect class={i === 0 ? 'il-destaque' : 'il-neutro'} x="16" y={y} width="58" height="10" rx="5" />
  ))}
  {kpis.map((x, i) => (
    <>
      <rect class="il-kpi" x={x} y="20" width="92" height="58" rx="8" />
      <rect class="il-neutro" x={x + 12} y="34" width="40" height="8" rx="4" />
      <rect class={i === 0 ? 'il-destaque' : 'il-forte'} x={x + 12} y="52" width="60" height="14" rx="3" />
    </>
  ))}
  <rect class="il-grafico" x="108" y="94" width="296" height="110" rx="8" />
  {barras.map((b) => (
    <rect class={b.destaque ? 'il-destaque' : 'il-neutro'} x={b.x} y={b.y} width="20" height={b.h} rx="3" />
  ))}
  {[218, 242, 266].map((y) => (
    <rect class="il-linha" x="108" y={y} width="296" height="16" rx="4" />
  ))}
</svg>
