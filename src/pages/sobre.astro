---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Sobre | Djara, Designer de UI/UX" description="Sobre Djara: formação, experiência e habilidades em UI/UX.">

  <!-- ================= TOPO: TEXTO + FOTO ================= -->
  <section class="sobre" aria-labelledby="titulo-sobre">
    <div class="container sobre-grade">

      <div class="coluna-sobre">
        <h1 class="titulo-pagina" id="titulo-sobre">Sobre mim</h1>

        <div class="texto">
          <!-- PARÁGRAFO: copie uma linha <p>...</p> para adicionar mais -->
          <p>Sou Djara, designer de UI/UX. Gosto de transformar problemas complexos em interfaces simples, acessíveis e agradáveis de usar.</p>
          <p>Hoje trabalho no <strong>Instituto Atlântico</strong>, onde participo de projetos de produtos digitais do início ao fim: da pesquisa com usuários ao protótipo de alta fidelidade e à entrega para o time de desenvolvimento.</p>
          <p>Meu processo começa ouvindo as pessoas. Combino entrevistas, testes de usabilidade e dados de uso para tomar decisões de design, e trabalho de perto com produto e desenvolvimento para que a solução chegue ao usuário como foi pensada.</p>
        </div>
      </div>

      <!-- IMAGEM: troque o arquivo public/img/perfil.jpeg -->
      <div class="imagem sobre-foto">
        <img src={url('img/perfil.jpeg')} alt="Foto de Djara">
      </div>

    </div>
  </section>

  <!-- ================= FORMAÇÃO ================= -->
  <section class="sobre-secao" aria-labelledby="titulo-formacao">
    <div class="container">
      <div class="coluna-sobre">
        <h2 class="titulo-secao" id="titulo-formacao">Formação</h2>

        <div class="lista-sobre">

          <!-- FORMAÇÃO 1: copie daqui até FIM DA FORMAÇÃO 1 -->
          <div class="item-sobre">
            <h3 class="item-sobre-nome">Universidade Exemplo</h3>
            <ul class="item-sobre-detalhe">
              <li>Bacharelado em Design • 2023</li>
            </ul>
          </div>
          <!-- FIM DA FORMAÇÃO 1 -->

        </div>
      </div>
    </div>
  </section>

  <!-- ================= EXPERIÊNCIA ================= -->
  <section class="sobre-secao" aria-labelledby="titulo-experiencia">
    <div class="container">
      <div class="coluna-sobre">
        <h2 class="titulo-secao" id="titulo-experiencia">Experiência</h2>

        <div class="lista-sobre">

          <!-- EXPERIÊNCIA 1: copie daqui até FIM DA EXPERIÊNCIA 1 -->
          <div class="item-sobre">
            <h3 class="item-sobre-nome">Instituto Atlântico</h3>
            <ul class="item-sobre-detalhe">
              <li>Designer de UI/UX • mar/2024 – atual</li>
            </ul>
          </div>
          <!-- FIM DA EXPERIÊNCIA 1 -->

          <!-- EXPERIÊNCIA 2: copie daqui até FIM DA EXPERIÊNCIA 2 -->
          <div class="item-sobre">
            <h3 class="item-sobre-nome">Agência Exemplo</h3>
            <ul class="item-sobre-detalhe">
              <li>Estágio em Design de Produto • jan/2023 – fev/2024</li>
            </ul>
          </div>
          <!-- FIM DA EXPERIÊNCIA 2 -->

        </div>
      </div>
    </div>
  </section>

  <!-- ================= HABILIDADES ================= -->
  <section class="sobre-secao" aria-labelledby="titulo-habilidades">
    <div class="container">
      <div class="coluna-sobre">
        <h2 class="titulo-secao" id="titulo-habilidades">Habilidades</h2>

        <div class="lista-sobre">

          <!-- HABILIDADE 1: copie daqui até FIM DA HABILIDADE 1 -->
          <div class="item-sobre">
            <h3 class="item-sobre-nome">Design</h3>
            <ul class="item-sobre-detalhe">
              <li>Pesquisa com usuários • Arquitetura da informação • Wireframes • Prototipação • Testes de usabilidade • Design system • Acessibilidade</li>
            </ul>
          </div>
          <!-- FIM DA HABILIDADE 1 -->

          <!-- HABILIDADE 2: copie daqui até FIM DA HABILIDADE 2 -->
          <div class="item-sobre">
            <h3 class="item-sobre-nome">Ferramentas</h3>
            <ul class="item-sobre-detalhe">
              <li>Figma • FigJam • Maze • Miro • Notion • HTML e CSS</li>
            </ul>
          </div>
          <!-- FIM DA HABILIDADE 2 -->

        </div>

        <p class="sobre-acoes">
          <a class="botao" href={url('curriculo.pdf')} target="_blank" rel="noopener">Currículo<span class="visualmente-oculto"> (abre em nova aba)</span></a>
        </p>
      </div>
    </div>
  </section>

</BaseLayout>
