---
// Botão de tema claro/escuro. A escolha fica salva no navegador.
---

<button class="tema-botao" type="button" aria-label="Tema escuro" aria-pressed="false" data-tema-botao>
  <svg class="tema-icone-lua" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
  <svg class="tema-icone-sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
</button>

<script>
  const botao = document.querySelector<HTMLButtonElement>('[data-tema-botao]');
  const raiz = document.documentElement;

  const sincronizar = () => botao?.setAttribute('aria-pressed', String(raiz.dataset.theme === 'dark'));

  sincronizar();
  botao?.addEventListener('click', () => {
    const tema = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = tema;
    try {
      localStorage.setItem('tema', tema);
    } catch {}
    sincronizar();
  });
</script>
